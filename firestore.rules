rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User-owned profile documents only. Expand deliberately when the app
    // introduces additional cloud-backed features.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny all other documents until explicit rules are added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
